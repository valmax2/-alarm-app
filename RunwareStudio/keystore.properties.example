# Copy this file to keystore.properties (same folder) and fill in the real values — that
# file is git-ignored and must never be committed. Generate a release keystore once
# (`keytool -genkey -v -keystore release.keystore -alias runwarestudio_upload -keyalg RSA
# -keysize 2048 -validity 10000`) and keep it somewhere safe and backed up outside this repo.
# Losing it means RunwareStudio can never be updated under the same Play Store listing again.
storeFile=release.keystore
storePassword=
keyAlias=runwarestudio_upload
keyPassword=
