# Copy this file to keystore.properties (same folder) and fill in the real values — that
# file is git-ignored and must never be committed. The actual release.keystore this points to
# was generated once and sent to you directly; keep both somewhere safe and backed up outside
# this repo. Losing them means FaceGuard can never be updated under the same Play Store listing
# again.
storeFile=release.keystore
storePassword=
keyAlias=faceguard_upload
keyPassword=
