# Copia questo file in `.env` (nella stessa cartella apps/bridge) per personalizzare la
# configurazione. Nessuno di questi valori è hardcoded nel codice.

COMFY_DIRECTOR_HOST=127.0.0.1
COMFY_DIRECTOR_PORT=8787

# URL di default proposto nel form impostazioni al primo avvio (l'utente può cambiarlo
# dalla UI in qualsiasi momento; quel valore viene poi persistito nel DB, non qui).
COMFY_DIRECTOR_DEFAULT_COMFY_BASE_URL=http://127.0.0.1:8188

COMFY_DIRECTOR_LOG_LEVEL=INFO
