# Copia questo file in keystore.properties (stessa cartella) e compila i valori reali — quel
# file è ignorato da git e non va mai committato. Il release.keystore a cui punta va generato
# una volta sola e conservato al sicuro: perderlo significa non poter più aggiornare
# VoiceClone Studio sotto lo stesso annuncio Play Store.
storeFile=release.keystore
storePassword=
keyAlias=voiceclonestudio_upload
keyPassword=
