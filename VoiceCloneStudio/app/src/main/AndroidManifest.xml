<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Solo per registrare i campioni vocali (clonazione) e l'audio sorgente per la
         conversione voce→voce. La dettatura del testo usa l'app di riconoscimento vocale
         di sistema (RecognizerIntent), che non richiede questo permesso alla nostra app. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:name=".VoiceCloneApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.VoiceCloneStudio"
        android:usesCleartextTraffic="true">
        <!-- Serve solo per parlare con il server personale sulla rete locale (http://192.168.x.x),
             che non ha senso mettere dietro HTTPS: le chiamate a ElevenLabs restano su https. -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Espone i file audio generati (cartella interna dell'app) ad altre app tramite un
             content:// URI, per il pulsante "Condividi". -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="it.vstudioapps.voiceclonestudio.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
